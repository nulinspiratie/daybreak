{
  "name": "daybreak",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "seed": "bun scripts/seed.ts",
    "test:bun": "bun test ./packages/core/test/sqlite-bun.smoke.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/server && tsc --noEmit -p scripts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
