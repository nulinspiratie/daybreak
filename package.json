{
  "name": "daybreak",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "seed": "bun scripts/seed.ts",
    "test:bun": "bun test ./packages/core/test/sqlite-bun.smoke.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/server && tsc --noEmit -p scripts && tsc --noEmit -p apps/web",
    "start": "bun run --cwd apps/web build && bun packages/server/src/main.ts",
    "dev": "bun packages/server/src/main.ts --dev",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:bun",
    "smoke": "bun scripts/smoke.ts",
    "prepare": "bun scripts/install-hooks.ts",
    "format": "biome check --write .",
    "lint": "biome ci --error-on-warnings ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "^1.4.4",
    "@types/node": "26",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
