{
  "id": "/",
  "name": "Daybreak",
  "short_name": "Daybreak",
  "description": "Task manager and daily planner for work",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#f3f3f3",
  "theme_color": "#f3f3f3",
  "icons": [
    { "src": "/daybreak.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
